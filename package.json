{
  "name": "ssff-project",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap-ai-sdk/foundation-models": "^2.17.0",
    "@sap-ai-sdk/orchestration": "^2.17.0",
    "@sap-cloud-sdk/connectivity": "^3",
    "@sap-cloud-sdk/http-client": "^3",
    "@sap-cloud-sdk/resilience": "^3",
    "@sap/cds": "^10.2.0",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.13.0",
    "jest": "^30.2.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-project1": "cds watch --open project1/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-project2": "cds watch --open project2/index.html?sap-ui-xx-viewCache=false --livereload false",
    "test": "cds bind --exec -- jest --silent=true",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "private": true,
  "cds": {
    "requires": {
      "ECEmployeeProfile": {
        "[production]": {
          "kind": "odata-v2",
          "model": "srv/external/ECEmployeeProfile",
          "credentials": {
            "destination": "ECEmployeeProfile"
          }
        },
        "[development]": {
          "kind": "odata-v2",
          "model": "srv/external/ECEmployeeProfile"
        },
        "[hybrid]": {
          "kind": "odata-v2",
          "model": "srv/external/ECEmployeeProfile",
          "credentials": {
            "destination": "ECEmployeeProfile"
          }
        }
      },
      "PLTUserManagement": {
        "[production]": {
          "kind": "odata-v2",
          "model": "srv/external/PLTUserManagement",
          "credentials": {
            "destination": "PLTUserManagement"
          }
        },
        "[development]": {
          "kind": "odata-v2",
          "model": "srv/external/PLTUserManagement",
          "credentials": {
            "destination": "PLTUserManagement"
          }
        },
        "[hybrid]": {
          "kind": "odata-v2",
          "model": "srv/external/PLTUserManagement",
          "credentials": {
            "destination": "PLTUserManagement"
          }
        }
      },
      "auth": "mocked",
      "aicore": {
        "kind": "rest",
        "[hybrid]": {
          "credentials": {
            "destination": "aicore"
          }
        },
        "[production]": {
          "credentials": {
            "destination": "aicore"
          }
        }
      },
      "[hybrid]": {
        "destinations": {
          "binding": {
            "type": "cf",
            "apiEndpoint": "https://api.cf.eu10-005.hana.ondemand.com",
            "org": "A&C",
            "space": "dev",
            "instance": "destination-service",
            "key": "destination-service-key"
          },
          "kind": "destinations",
          "vcap": {
            "name": "destinations"
          }
        }
      },
      "[production]": {
        "auth": "xsuaa"
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true,
      "db": {
        "kind": "sqlite:memory"
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/project2",
    "app/project1"
  ],
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "srv/**/*.js",
      "!srv/external/**",
      "!**/node_modules/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
